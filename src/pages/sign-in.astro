---
import '../../generated/fonts.css';
import '../site-components/global.css';
import '../styles/global.css';

import MainLayout from '../layouts/main.astro';
import ClerkSignIn from '../components/ClerkSignIn';

---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/png" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width" />
  <title>Sign In | Metrics Dashboard</title>
</head>
<MainLayout pageClass="">
  <ClerkSignIn client:only="react" />
</MainLayout>
<style>
  /* Force light mode for this page */
  :global(body.__DARK_MODE_CLASS__) {
    background: linear-gradient(rgba(22, 54, 102, 0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(22, 54, 102, 0.035) 1px, transparent 1px),
                #fafafa !important;
    background-size: 40px 40px !important;
    color: var(--rebel-blue) !important;
  }
</style>
</html>
