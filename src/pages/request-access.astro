

---
import MainLayout from '../layouts/main.astro';
---

<MainLayout pageClass="auth-page">
  <div class="min-h-screen bg-black flex items-center justify-center p-4">
    <div class="w-full max-w-md">
      <div id="waitlist"></div>
    </div>
  </div>
</MainLayout>

<script>
  import { Clerk } from '@clerk/clerk-js';

  const clerkPubKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY;

  if (!clerkPubKey) {
    throw new Error('Missing Clerk Publishable Key');
  }

  const clerk = new Clerk(clerkPubKey);
  await clerk.load();

  const waitlistDiv = document.getElementById('waitlist') as HTMLDivElement;

  if (waitlistDiv) {
    clerk.mountWaitlist(waitlistDiv, {
      appearance: {
        elements: {
          rootBox: 'w-full',
          card: 'bg-[#0a0a0a] border border-[rgba(255,255,255,0.13)] rounded-lg shadow-xl',
          headerTitle: 'text-white text-2xl font-bold',
          headerSubtitle: 'text-[rgba(255,255,255,0.67)]',
          formButtonPrimary: 'bg-white text-black hover:bg-[rgba(255,255,255,0.9)]',
          formFieldInput: 'bg-[#1a1a1a] border border-[rgba(255,255,255,0.13)] text-white',
          footerActionLink: 'text-white hover:text-[rgba(255,255,255,0.8)]',
          formFieldLabel: 'text-[rgba(255,255,255,0.67)]',
        },
      },
      signInUrl: '/sign-in',
    });
  }
</script>


