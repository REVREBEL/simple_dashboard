---
import MainLayout from '../layouts/main.astro';
---

<MainLayout pageClass="landing">
<div class="min-h-screen bg-[#fafafa] text-[#163666]" style="background: linear-gradient(rgba(22, 54, 102, 0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(22, 54, 102, 0.035) 1px, transparent 1px), #fafafa; background-size: 40px 40px;">
<nav class="border-b border-[rgba(22,54,102,0.14)] p-4 bg-[#eff5f6]/80 backdrop-blur-sm">
<div class="max-w-7xl mx-auto flex justify-between items-center">
  <h1 class="text-xl font-bold text-[#163666]">Metrics Dashboard</h1>
  <div class="flex gap-3">
    <a href="/sign-in" class="px-4 py-2 border border-[rgba(22,54,102,0.16)] rounded hover:bg-[rgba(22,54,102,0.04)] transition">
      Sign In
    </a>
    <a href="/request-access" class="px-4 py-2 bg-[#163666] text-[#eff5f6] rounded hover:bg-[#047c97] transition font-medium">
      Request Access
    </a>
  </div>
</div>
</nav>

<main class="max-w-7xl mx-auto px-8 py-20">
<div class="text-center max-w-3xl mx-auto">
  <h1 class="text-5xl md:text-6xl font-bold mb-6 text-[#163666]">
    Level Up with Metrics
  </h1>
  <p class="text-xl text-[rgba(22,54,102,0.68)] mb-8">
    Connect the dots into a clearer view of property performance. Live hotel segment and channel performance reporting.
  </p>
  <div class="flex gap-4 justify-center">
    <a href="/request-access" class="px-8 py-3 bg-[#163666] text-[#eff5f6] rounded-lg hover:bg-[#047c97] transition font-medium text-lg">
      Get Started
    </a>
    <a href="/sign-in" class="px-8 py-3 border border-[rgba(22,54,102,0.16)] rounded-lg hover:bg-[rgba(22,54,102,0.04)] transition text-lg">
      Sign In
    </a>
  </div>
</div>

<div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8">
  <div class="bg-white border border-[rgba(22,54,102,0.14)] rounded-lg p-8 shadow-sm">
    <div class="text-4xl mb-4">📊</div>
    <h3 class="text-xl font-semibold mb-3 text-[#163666]">Real-Time Analytics</h3>
    <p class="text-[rgba(22,54,102,0.68)]">
      Track your hotel's performance with live data and actionable insights.
    </p>
  </div>

  <div class="bg-white border border-[rgba(22,54,102,0.14)] rounded-lg p-8 shadow-sm">
    <div class="text-4xl mb-4">🎯</div>
    <h3 class="text-xl font-semibold mb-3 text-[#163666]">Channel Performance</h3>
    <p class="text-[rgba(22,54,102,0.68)]">
      Monitor and optimize performance across all your booking channels.
    </p>
  </div>

  <div class="bg-white border border-[rgba(22,54,102,0.14)] rounded-lg p-8 shadow-sm">
    <div class="text-4xl mb-4">💡</div>
    <h3 class="text-xl font-semibold mb-3 text-[#163666]">Smart Reporting</h3>
    <p class="text-[rgba(22,54,102,0.68)]">
      Generate comprehensive reports to make data-driven decisions.
    </p>
  </div>
</div>
</main>
</div>
</MainLayout>

<script>
import { Clerk } from '@clerk/clerk-js';

const clerkPubKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY;

if (clerkPubKey) {
const clerk = new Clerk(clerkPubKey);
await clerk.load();

// Redirect to dashboard if already signed in
if (clerk.user) {
window.location.href = '/dashboard';
}
}
</script>

