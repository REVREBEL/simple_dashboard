---
import MainLayout from '../layouts/main.astro';
---

<MainLayout pageClass="landing">
  <div class="min-h-screen bg-black text-white">
    <nav class="border-b border-[rgba(255,255,255,0.13)] p-4">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <h1 class="text-xl font-bold">Metrics Dashboard</h1>
        <div class="flex gap-3">
          <a href="/sign-in" class="px-4 py-2 border border-[rgba(255,255,255,0.13)] rounded hover:bg-[rgba(255,255,255,0.05)] transition">
            Sign In
          </a>
          <a href="/request-access" class="px-4 py-2 bg-white text-black rounded hover:bg-[rgba(255,255,255,0.9)] transition font-medium">
            Request Access
          </a>
        </div>
      </div>
    </nav>

    <main class="max-w-7xl mx-auto px-8 py-20">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">
          Level Up with Metrics
        </h1>
        <p class="text-xl text-[rgba(255,255,255,0.67)] mb-8">
          Connect the dots into a clearer view of property performance. Live hotel segment and channel performance reporting.
        </p>
        <div class="flex gap-4 justify-center">
          <a href="/request-access" class="px-8 py-3 bg-white text-black rounded-lg hover:bg-[rgba(255,255,255,0.9)] transition font-medium text-lg">
            Get Started
          </a>
          <a href="/sign-in" class="px-8 py-3 border border-[rgba(255,255,255,0.13)] rounded-lg hover:bg-[rgba(255,255,255,0.05)] transition text-lg">
            Sign In
          </a>
        </div>
      </div>

      <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-[#0a0a0a] border border-[rgba(255,255,255,0.13)] rounded-lg p-8">
          <div class="text-4xl mb-4">📊</div>
          <h3 class="text-xl font-semibold mb-3">Real-Time Analytics</h3>
          <p class="text-[rgba(255,255,255,0.67)]">
            Track your hotel's performance with live data and actionable insights.
          </p>
        </div>

        <div class="bg-[#0a0a0a] border border-[rgba(255,255,255,0.13)] rounded-lg p-8">
          <div class="text-4xl mb-4">🎯</div>
          <h3 class="text-xl font-semibold mb-3">Channel Performance</h3>
          <p class="text-[rgba(255,255,255,0.67)]">
            Monitor and optimize performance across all your booking channels.
          </p>
        </div>

        <div class="bg-[#0a0a0a] border border-[rgba(255,255,255,0.13)] rounded-lg p-8">
          <div class="text-4xl mb-4">💡</div>
          <h3 class="text-xl font-semibold mb-3">Smart Reporting</h3>
          <p class="text-[rgba(255,255,255,0.67)]">
            Generate comprehensive reports to make data-driven decisions.
          </p>
        </div>
      </div>
    </main>
  </div>
</MainLayout>

<script>
  import { Clerk } from '@clerk/clerk-js';

  const clerkPubKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY;

  if (clerkPubKey) {
    const clerk = new Clerk(clerkPubKey);
    await clerk.load();

    // Redirect to dashboard if already signed in
    if (clerk.user) {
      window.location.href = '/dashboard';
    }
  }
</script>
