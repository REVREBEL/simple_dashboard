---
import '../../generated/fonts.css';
import '../site-components/global.css';
import '../styles/global.css';
import { ClerkProvider } from '@clerk/clerk-react';
import ClerkSignInPage from '../components/ClerkSignIn';

const clerkPubKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY;
---

<html lang="en">
<head>
<meta charset="utf-8" />
<link rel="icon" type="image/png" href="/favicon.ico" />
<meta name="viewport" content="width=device-width" />
<title>Sign In | Metrics Dashboard</title>
</head>
<body>
<ClerkProvider publishableKey={clerkPubKey} client:only="react">
  <ClerkSignInPage client:only="react" />
</ClerkProvider>
</body>
</html>
